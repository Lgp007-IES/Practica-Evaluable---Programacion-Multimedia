<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wm_bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="monospace"
        android:text="[ THE WORLD MACHINE ]"
        android:textColor="@color/oneshot_yellow"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:fontFamily="monospace"
        android:text="Configuración inicial del sistema"
        android:textColor="@color/wm_text_light"
        android:textSize="14sp" />

    <!-- Nombre -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="Nombre del Usuario:"
        android:textColor="@color/oneshot_yellow" />

    <EditText
        android:id="@+id/etNombreConfig"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@color/wm_surface"
        android:fontFamily="monospace"
        android:hint="Ej: Niko"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/wm_text_light" />

    <!-- Campo: Teléfono por defecto -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="Teléfono de contacto:"
        android:textColor="@color/oneshot_yellow" />

    <EditText
        android:id="@+id/etTelefonoConfig"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@color/wm_surface"
        android:fontFamily="monospace"
        android:hint="Ej: 5555054455"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/wm_text_light" />

    <!-- URL por defecto -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="URL por defecto:"
        android:textColor="@color/oneshot_yellow" />

    <EditText
        android:id="@+id/etUrlConfig"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="28dp"
        android:background="@color/wm_surface"
        android:fontFamily="monospace"
        android:hint="https://oneshot.fandom.com"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/wm_text_light" />

    <!-- Botón Guardar e Iniciar -->
    <Button
        android:id="@+id/btnGuardarConfig"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/wm_purple_btn"
        android:fontFamily="monospace"
        android:text="GUARDAR Y ENTRAR"
        android:textColor="@color/oneshot_yellow"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>